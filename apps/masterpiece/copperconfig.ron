    ),
        (
        src: "moteus/turret_data",
        dst: "moteus_data_splitter",
        msg: "moteus_bridge :: messages :: MoteusData",
    ),
        (
        src: "moteus/shooter_data",
        dst: "moteus_turret_state_assembler",
        msg: "moteus_bridge :: messages :: MoteusData",
    ),
        (
        src: "diffdrivecmd",
        dst: "moteus/drive_left",
        msg: "diffdrive::LeftMotorCMD",
    ),
        (
        src: "diffdrivecmd",
        dst: "moteus/drive_right",
        msg: "diffdrive::RightMotorCMD",
    ),
        (
        src: "s1_intake_state_machine",
