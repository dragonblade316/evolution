(
    tasks: [
        (
        id: "joytodrive",
        type: "drive_utils::ArcadeDrive",
        kind: task,
    ),
        (
        id: "drivetokinematics",
        type: "diffdrive::DiffDriveKinematics",
        kind: task,
    ),
        (
        id: "dsrx",
        type: "evods::cu29::tasks::DsRx",
        kind: task,
    ),
        (
        id: "pose_estimator",
        type: "iekflocalizer::IEKFPoseEstimator",
        kind: task,
    ),
        (
        id: "camera",
        type: "cu_v4l::V4l",
        kind: source,
        run_in_sim: false,
        config: {
            "device": 0,
            "width": 1280,
            "height": 720,
            "fourcc": "GREY",
            "buffers": 4,
            "timeout_ms": 500,
        },
    ),
        (
        id: "apriltag_detector",
        type: "cu_apriltag::AprilTags",
        kind: task,
        config: {
            "family": "tag16h5",
            "bits_corrected": 1,
            "tag_size": 0.0,
            "fx": 1077.5364936413373,
            "fy": 1077.7948707218447,
            "cx": 605.5026981265167,
            "cy": 399.29058993159094,
        },
    ),
        (
        id: "apriltag_pose",
        type: "apriltag_tasks::AprilTagPoseProcessor",
        kind: task,
        config: {
            "tags": [
                {
                    "id": 0,
                    "field_pose": {
                        "translation_m": [0.0, 0.0, 0.0],
                        "rotation_radians": [0.0, 0.0, 0.0],
                    },
                },
            ],
            "robot_to_camera_pose": {
                "translation_m": [0.0, 0.0, 0.0],
                "rotation_radians": [0.0, 0.0, 0.0],
            },
            "min_decision_margin": 0.0,
            "ground_z_m": 0.0,
            "max_ground_distance_m": 0.25,
        },
    ),
        (
        id: "poselog",
        type: "tasks::PoseLogSink",
        kind: sink,
        run_in_sim: true,
    ),
        (
        id: "speedslog",
        type: "tasks::SpeedsLogSink",
        kind: sink,
        run_in_sim: true,
    ),
        (
        id: "odom",
        type: "diffdrive::odom::DiffDriveOdometry",
        kind: task,
    ),
        (
        id: "diffdrivereader",
        type: "moteus_tasks::MoteusDiff",
        kind: task,
    ),
        (
        id: "diffdrivecmd",
        type: "diffdrive::DiffDriveCmd",
        kind: task,
    ),
        (
        id: "s1_behavior",
        type: "tasks::MainBehaviorTree::S1Behavior",
        kind: task,
    ),
        (
        id: "turret_check",
        type: "turret_tasks::TurretCheck",
        kind: task,
    ),
        (
        id: "turret_angle_solver",
        type: "turret_tasks::TurretAngleSolver",
        kind: task,
    ),
        (
        id: "s_o_t_m",
        type: "sotm_rt::SOTM",
        kind: task,
    ),
        (
        id: "turret_c_m_d",
        type: "tasks::TurretCmd::TurretCMD",
        kind: task,
    ),
        (
        id: "moteus_turret_state_assembler",
        type: "moteus_tasks::MoteusTurretStateAssembler",
        kind: task,
    ),
        (
        id: "s1_intake_state_machine",
        type: "tasks::IntakeStateMachine::S1IntakeStateMachine",
        kind: task,
    ),
        (
        id: "binary_servo",
        type: "rpsinks::BinaryServo",
        kind: sink,
    ),
        (
        id: "muzzle_velocity_turret_state_assembler",
        type: "turret_tasks::MuzzleVelocityTurretStateAssembler",
        kind: task,
    ),
    (
        id: "alliance_transform_selector",
        type: "allience_spesific_tasks::AllianceTransformSelector",
        kind: task,
        config: {
            "red_transform": [
                [1.0, 0.0, 0.0, 2.365],
                [0.0, 1.0, 0.0, 2.319],
                [0.0, 0.0, 1.0, 0.551],
                [0.0, 0.0, 0.0, 1.0],
            ],
            "blue_transform": [
                [1.0, 0.0, 0.0, 0.035],
                [0.0, 1.0, 0.0, 0.081],
                [0.0, 0.0, 1.0, 0.551],
                [0.0, 0.0, 0.0, 1.0],
            ],
        },
    ),
        (
        id: "moteus_data_splitter",
        type: "moteus_tasks::MoteusDataSplitter",
        kind: task,
    ),
    ],
    bridges: [
        (
        id: "evo_ds_bridge",
        type: "bridges::EvoDsBridge",
        config: {
            "wire_format": "json",
        },
        channels: [
            Tx(
            id: "telemetry",
            route: "evods/tel/pose",
        ),
            Rx(
            id: "command",
            route: "evods/ds",
        ),
        ],
    ),
        (
        id: "moteus",
        type: "bridges::UziMoteusBridge",
        run_in_sim: false,
        channels: [
            Tx(
            id: "drive_left",
            route: "moteus/drive_left/cmd",
        ),
            Tx(
            id: "drive_right",
            route: "moteus/drive_right/cmd",
        ),
            Tx(
            id: "indexer",
            route: "moteus/indexer/cmd",
        ),
            Tx(
            id: "turret",
            route: "moteus/turret/cmd",
        ),
            Tx(
            id: "shooter",
            route: "moteus/shooter/cmd",
        ),
            Rx(
            id: "drive_left_data",
            route: "moteus/drive_left/data",
        ),
            Rx(
            id: "drive_right_data",
            route: "moteus/drive_right/data",
        ),
            Rx(
            id: "indexer_data",
            route: "moteus/indexer/data",
        ),
            Rx(
            id: "turret_data",
            route: "moteus/turret/data",
        ),
            Rx(
            id: "shooter_data",
            route: "moteus/shooter/data",
        ),
        ],
    ),
    ],
    cnx: [
        (
        src: "joytodrive",
        dst: "drivetokinematics",
        msg: "common::ChassisSpeeds",
    ),
        (
        src: "drivetokinematics",
        dst: "diffdrivecmd",
        msg: "common::DiffDriveSpeeds",
    ),
        (
        src: "diffdrivereader",
        dst: "odom",
